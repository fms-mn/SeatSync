# Supabase Session Pooler (Dashboard > Connect > Session pooler).
# Use the exact host and project reference copied from your dashboard.
DATABASE_URL="postgresql://prisma.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require&connection_limit=5&connect_timeout=30"

# Direct connection used only by Prisma migrations. It normally requires IPv6.
# If your deployment cannot reach IPv6, use the Session Pooler URL here too.
DIRECT_URL="postgresql://prisma:URL_ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require&connect_timeout=30"

JWT_SECRET="replace-with-at-least-32-random-characters"
PORT=4000
CLIENT_URL="http://localhost:5173"
VITE_API_URL="http://localhost:4000"
ADMIN_SEED_PASSWORD="choose-a-local-development-password"
